# Copy this file to .env.local and fill in real values.
# Both are optional — the site works fully without either, just with no
# analytics and no ads. Nothing here should ever be a secret; NEXT_PUBLIC_
# vars are compiled into the client bundle and visible to anyone.

# Google Analytics 4 measurement ID, from admin > Data Streams > your stream.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID, from Account > Account information.
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
